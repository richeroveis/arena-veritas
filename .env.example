# Copy to .env and fill in. Never commit .env.
# Deployer/private account key used by the GenLayer CLI (0x-prefixed hex).
GENLAYER_PRIVATE_KEY=
# GitHub classic or fine-grained token with repo scope (public repo creation + push).
GITHUB_TOKEN=
# Deployed ArenaVeritas intelligent contract address on studionet.
CONTRACT_ADDRESS=
# Public wallet key used only for read demos / seeding if needed.
GENLAYER_PUBLIC_KEY=
